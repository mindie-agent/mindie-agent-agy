{
  "mcpServers": {
    "mindie-remote-dev": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--python",
        "3.13",
        "python",
        "-B",
        "-X",
        "utf8",
        "scripts/mindie_launch.py",
        "mcp",
        "remote"
      ],
      "env": {
        "AGY_PLUGIN_ROOT": ".",
        "REMOTE_DEV_HARNESS_PROFILE": "agy",
        "UV_SYSTEM_CERTS": "true",
        "UV_NATIVE_TLS": "true",
        "GIT_TERMINAL_PROMPT": "0",
        "GCM_INTERACTIVE": "never",
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8"
      }
    },
    "mindie-tools": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--python",
        "3.13",
        "python",
        "-B",
        "-X",
        "utf8",
        "scripts/mindie_launch.py",
        "mcp",
        "tools"
      ],
      "env": {
        "AGY_PLUGIN_ROOT": ".",
        "UV_SYSTEM_CERTS": "true",
        "UV_NATIVE_TLS": "true",
        "GIT_TERMINAL_PROMPT": "0",
        "GCM_INTERACTIVE": "never",
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8"
      }
    }
  }
}
